{
  "expo": {
    "name": "Student Market",
    "slug": "student-market-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo.png",
    "userInterfaceStyle": "light",
    "scheme": "studentmarket",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studentmarket.app",
      "associatedDomains": ["applinks:studentmarket.co.ke"]
    },
    "android": {
      "package": "com.studentmarket.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo.png",
        "backgroundColor": "#12452F"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "studentmarket.co.ke",
              "pathPrefix": "/product"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/Logo.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-screen.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ba1efccb-f20c-4e5d-b5f3-eb2dd072046b"
      }
    }
  }
}